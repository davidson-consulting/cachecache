in front;

mod ::follow;
mod ::user;
mod ::submit;
mod ::timeline;
mod ::service;

use std::{config::_, io, fs::path};
use std::{net::_, concurrency::actor};

use etc::c::process;

use socialnet::{utils::_,
                config::_,
                registry::_,
                services::_,
                front::_};

lazy dmut __SYSTEM__ : [(&ActorSystem)?] = copy [none];

fn killSystem (code : u32) {
    if let Ok (dmut s) = alias __SYSTEM__ [0] {
        log::warn ("Kill", "FRONT", "actor system (signal code : ", code, ")");
        s:.kill ();
    }
}

pub fn frontMain (cfg : &Config) {
    let serviceCfg = config::SocialNetConfiguration (cfg);

    signal (SignalCodes::SIGINT, &killSystem);
    signal (SignalCodes::SIGTERM, &killSystem);
    signal (SignalCodes::SIGKILL, &killSystem);

    let systemAddr = SockAddr (serviceCfg.system.addr, serviceCfg.system.port);
    log::info ("Create", "FRONT", "actor system on ", systemAddr);
    let dmut system = copy ActorSystem (systemAddr, nbThreads-> serviceCfg.system.nbThreads);

    {
        system:.add (serviceCfg.front.name, copy FrontActor (serviceCfg));
    } catch {
        error => {
            log::error ("Failed", "SERVICE", error);
            return;
        }
    }

    log::info ("Starting", "FRONT", "actor system");
    {
        system:.start ();
    } catch {
        inE => {
            log::error ("Error", "FRONT", "while sarting actor system : \n => \t", inE);
            return;
        }
    }
    log::info ("Running", "FRONT", "actor system is running on ", system.ip, ":", system.port);

    __SYSTEM__ [0] = (alias system)?;
    system:.join ();

    log::info ("Exiting", "FRONT", "services");
}
