in interface;

pub extern (C) fn mysql_library_init (argc : u32 = 0, argv : *void = null, groups : *void = null)-> i32;
pub extern (C) fn mysql_init (mysql : *void = null)-> *void;
pub extern (C) fn mysql_real_connect (mysql : *void, server : *c8, user : *c8, password : *c8, db : *c8, port : u32, unix_socket : *void = null, client_flags : u32 = 0)-> i32;
pub extern (C) fn mysql_error (mysql : *void)-> *c8;
pub extern (C) fn mysql_close (mysql : *void);
pub extern (C) fn mysql_options (mysql : *void, opt : u32, arg : *void)-> i32;

pub extern (C) fn mysql_autocommit (mysql : *void, auto : i32);

pub extern (C) fn mysql_stmt_init (mysql : *void)-> *void;
pub extern (C) fn mysql_stmt_close (stmt : *void)-> *void;
pub extern (C) fn mysql_stmt_prepare (stmt : *void, query : *c8, size : u64)-> i32;
pub extern (C) fn mysql_stmt_param_count (stmt : *void)-> u32;
pub extern (C) fn mysql_stmt_result_metadata (stmt : *void)-> *void;
pub extern (C) fn mysql_free_result (metadata : *void);
pub extern (C) fn mysql_num_fields (metadata : *void)-> u32;

pub extern (C) fn mysql_stmt_bind_result (stmt : *void, result : *MYSQL_BIND)-> i32;
pub extern (C) fn mysql_stmt_bind_param (stmt : *void, result : *MYSQL_BIND)-> i32;
pub extern (C) fn mysql_stmt_insert_id (stmt : *void)-> u32;
pub extern (C) fn mysql_stmt_fetch (stmt : *void)-> i32;
pub extern (C) fn mysql_stmt_execute (stmt : *void)-> i32;

pub enum
| MYSQL_OPT_CONNECT_TIMEOUT = 0
 -> MysqlFlags;

/**
  Column types for MySQL
*/
pub enum : u32
| DECIMAL     = 0
| TINY        = 1
| SHORT       = 2
| LONG        = 3
| FLOAT       = 4
| DOUBLE      = 5
| NULL        = 6
| TIMESTAMP   = 7
| LONGLONG    = 8
| INT24       = 9
| DATE        = 10
| TIME        = 11
| DATETIME    = 12
| YEAR        = 13
| NEWDATE     = 14 /**< Internal to MySQL. Not used in protocol */
| VARCHAR     = 15
| BIT         = 16
| TIMESTAMP2  = 17
| DATETIME2   = 18   /**< Internal to MySQL. Not used in protocol */
| TIME2       = 19       /**< Internal to MySQL. Not used in protocol */
| TYPED_ARRAY = 20 /**< Used for replication only */
| INVALID     = 243
| BOOL        = 244 /**< Currently just a placeholder */
| JSON        = 245
| NEWDECIMAL  = 246
| ENUM        = 247
| SET         = 248
| TINY_BLOB   = 249
| MEDIUM_BLOB = 250
| LONG_BLOB   = 251
| BLOB        = 252
| VAR_STRING  = 253
| STRING      = 254
| GEOMETRY    = 255
 -> MysqlFieldTypes;



pub record MYSQL_BIND {
    pub let mut length : *u64 = null;
    pub let mut is_null : *bool = null;
    pub let mut buffer : *void = null;
    pub let mut error : *bool = null;
    pub let mut row_ptr : *c8 = null;
    pub let mut store_param_func : *void = null;
    pub let mut fetch_result : *void = null;
    pub let mut skip_result : *void = null;
    pub let mut buffer_length : u64 = 0;
    pub let mut offset : u64 = 0;
    pub let mut length_value : u64 = 0;
    pub let mut param_number : u32 = 0;
    pub let mut pack_length : u32 = 0;
    pub let mut buffer_type : MysqlFieldTypes = MysqlFieldTypes::DECIMAL;
    pub let mut error_value : bool = false;
    pub let mut is_unsigned : bool = false;
    pub let mut long_data_used : bool = false;
    pub let mut is_null_value : bool = false;
    pub let mut extension : *void = null;

    pub self () {}
}
