in short_url;

mod ::db;

use std::io;
use std::concurrency::actor;
use std::config::_;
use std::syntax::_;
use std::net::addr;

use std::{stream, format, conv, rand};

use socialnet::registry::_;
use socialnet::utils::_;
use socialnet::config::_;

def base64_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";

pub class ShortUrlService over ActorBase {

    let _config : SocialNetConfiguration;
    let _serviceConfig : ServiceConfig;

    // The registry of the service
    let dmut _registry : (&ActorRef)? = none;
    let mut _uid = 0us;
    let mut _needClose = false;

    let dmut _db : (&db::ShortUrlDatabase)? = none;

    pub self (serviceConfig : ServiceConfig, systemConfig : SocialNetConfiguration)
        with _config = systemConfig
        , _serviceConfig = serviceConfig
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onStart (mut self) {
        if self:.connectDatabase () {
            self:.connectRegistry ();
        }
    }

    fn connectDatabase (mut self)-> bool {
        log::info ("Starting", "short_url", "service connect database ", self._serviceConfig.db);
        for d in self._config.databases {
            if d.name == self._serviceConfig.db {
                self._db = (copy db::ShortUrlDatabase (server-> d.addr.to!{[c8]} (),
                                                       user-> d.user,
                                                       password-> d.password,
                                                       db-> d.dbName,
                                                       port-> d.port))?;
            }
        }

        if let Err (msg) = self._db {
            log::error ("Failed", "short_url", "failed to configure user database => ", msg);
            self:.kill ();
            return false;
        }
        else if let Err () = self._db {
            log::error ("Failed", "short_url", "failed to configure user database");
            self:.kill ();
            return false;
        }

        true
    }

    fn connectRegistry (mut self) {
        let regAddr = SockAddr (self._config.registry.addr, self._config.registry.port);
        log::info ("Starting", "short_url", "service connect registry ", regAddr);
        let dmut actor = self:.system:.remote (self._config.registry.name, regAddr);

        if let Ok (uid) = registry::utils::connect (alias actor, "short_url", self._name, SockAddr (self._config.system.loopback, self:.system.port)) {
            log::info ("Connected", "short_url", "service");
            self._needClose = true;
            self._uid = uid;
            self._registry = (alias actor)?;
        } else {
            log::error ("Failed", "short_url", "registry connection. Aborting ", self._name);
            self:.kill ();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          EXIT          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onQuit (mut self) {
        log::warn ("Killing", "short_url", "service ", self._name);
        if let Ok (dmut reg) = alias self._registry && self._needClose {
            registry::utils::close (alias reg, "short_url", self._name, SockAddr (self._config.system.loopback, self:.system.port));
        }

        if let Ok (dmut db) = alias self._db {
            db:.dispose ();
            self._db = none;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          MESSAGING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onMessage (mut self, rqt : &Config) {
        if let Ok (Int (value-> RequestCode::POISON_PILL)) = rqt ["code"]? {
            log::info ("Received", "short_url", "poison pill in ", self._name);
            self._needClose = false; // message comes from registry, no need to inform it from service exit
            self:.kill ();
        }
    }

    pub over onRequest (mut self, rqt : &Config)-> &Config {
        match rqt ["code"]? {
            Ok (Int (value-> RequestCode::CREATE_URL)) => {
                self:.create (rqt)
            }
            Ok (Int (value-> RequestCode::FIND_URL)) => {
                self:.find (rqt)
            }
            _ => {
                json#{"code" : ResponseCode::MALFORMED}
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CREATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub fn create (mut self, rqt : &Config)-> &Config {
        let dmut db = if let Ok (dmut db) = alias self._db { alias db }
        else {
            return json#{"code" : ResponseCode::ERROR};
        }

        {
            let url = rqt ["url"].to!{[c8]} ();
            if let Ok ((_, sh)) = db:.findByLong (url) {
                return json#{"code" : ResponseCode::OK, "short" : sh};
            }

            let chars = base64_chars;
            let sh = copy [chars [uniform (0u32, cast!u32 (chars.len))] for _ in 0 .. short_url::db::SHORT_LEN];
            db:.insert (sh, url);

            return json#{"code" : ResponseCode::OK, "short" : sh};
        } catch {
            _ => {}
        }

        return json#{"code" : ResponseCode::ERROR};
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          FIND          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub fn find (mut self, rqt : &Config)-> &Config {
        let dmut db = if let Ok (dmut db) = alias self._db { alias db }
        else {
            return json#{"code" : ResponseCode::ERROR};
        }

        {
            let url = rqt ["url"].to!{[c8]} ();
            if let Ok ((_, ln)) = db:.findByShort (url) {
                return json#{"code" : ResponseCode::OK, "long" : ln};
            }

            return json#{"code" : ResponseCode::NOT_FOUND};
        } catch {
            _ => {}
        }

        return json#{"code" : ResponseCode::ERROR};
    }

}
