in social_graph;

mod ::db;

use std::io;
use std::concurrency::actor;
use std::config::_;
use std::syntax::_;
use std::net::addr;

use std::{stream, format, conv};

use socialnet::registry::_;
use socialnet::utils::_;
use socialnet::config::_;

pub class SocialGraphService over ActorBase {

    let _config : SocialNetConfiguration;
    let _serviceConfig : ServiceConfig;

    // The registry of the service
    let dmut _registry : (&ActorRef)? = none;
    let mut _uid = 0us;
    let mut _needClose = false;

    let dmut _db : (&db::SocialGraphDatabase)? = none;

    pub self (serviceConfig : ServiceConfig, systemConfig : SocialNetConfiguration)
        with _config = systemConfig
        , _serviceConfig = serviceConfig
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onStart (mut self) {
        if self:.connectDatabase () {
            self:.connectRegistry ();
        }
    }

    fn connectDatabase (mut self)-> bool {
        log::info ("Starting", ServiceKind::SOCIAL_GRAPH, "service connect database ", self._serviceConfig.db);
        self._db = (copy db::SocialGraphDatabase ())?;

        if let Err (msg) = self._db {
            log::error ("Failed", ServiceKind::SOCIAL_GRAPH, "failed to configure social_graph database => ", msg);
            self:.kill ();
            return false;
        }
        else if let Err () = self._db {
            log::error ("Failed", ServiceKind::SOCIAL_GRAPH, "failed to configure social_graph database");
            self:.kill ();
            return false;
        }

        true
    }

    fn connectRegistry (mut self) {
        let regAddr = SockAddr (self._config.registry.addr, self._config.registry.port);
        log::info ("Starting", ServiceKind::SOCIAL_GRAPH, "service connect registry ", regAddr);
        let dmut actor = self:.system:.remote (self._config.registry.name, regAddr);

        if let Ok (uid) = registry::utils::connect (alias actor, ServiceKind::SOCIAL_GRAPH, self._name, SockAddr (self._config.system.loopback, self:.system.port)) {
            log::info ("Connected", ServiceKind::SOCIAL_GRAPH, "service");
            self._needClose = true;
            self._uid = uid;
            self._registry = (alias actor)?;
        } else {
            log::error ("Failed", ServiceKind::SOCIAL_GRAPH, "registry connection. Aborting ", self._name);
            self:.kill ();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          EXIT          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onQuit (mut self) {
        log::warn ("Killing", ServiceKind::SOCIAL_GRAPH, "service ", self._name);
        if let Ok (dmut reg) = alias self._registry && self._needClose {
            registry::utils::close (alias reg, ServiceKind::SOCIAL_GRAPH, self._name, SockAddr (self._config.system.loopback, self:.system.port));
        }

        self._db = none;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          MESSAGING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onMessage (mut self, rqt : &Config) {
        if let Ok (Int (value-> RequestCode::POISON_PILL)) = rqt ["code"]? {
            log::info ("Received", ServiceKind::SOCIAL_GRAPH, "poison pill in ", self._name);
            self._needClose = false; // message comes from registry, no need to inform it from service exit
            self:.kill ();
        }
    }

    pub over onRequest (mut self, rqt : &Config)-> &Config {
        match rqt ["code"]? {
            Ok (Int (value-> RequestCode::INSERT_SUB)) => {
                self:.insert (rqt)
            }
            Ok (Int (value-> RequestCode::IS_SUB)) => {
                self:.isSub (rqt)
            }
            Ok (Int (value-> RequestCode::REMOVE_SUB)) => {
                self:.remove (rqt)
            }
            Ok (Int (value-> RequestCode::COUNT_SUBS)) => {
                self:.count (rqt, subs-> true)
            }
            Ok (Int (value-> RequestCode::COUNT_FOLLOWERS)) => {
                self:.count (rqt, subs-> false)
            }
            Ok (Int (value-> RequestCode::FIND_SUBS)) => {
                self:.find (rqt, subs-> true)
            }
            Ok (Int (value-> RequestCode::FIND_FOLLOWERS)) => {
                self:.find (rqt, subs-> false)
            }
            _ => {
                json#{"code" : ResponseCode::MALFORMED}
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          INSERTION          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn insert (mut self, rqt : &Config)-> &Config {
        let dmut db = if let Ok (dmut db) = alias self._db { alias db }
        else {
            return json#{"code" : ResponseCode::ERROR};
        }

        {
            let uid = rqt ["userId"].to!{u32} ();
            let toWhom = rqt ["toWhom"].to!{u32} ();
            let token = rqt ["token"].to!{[c8]} ();

            if user::utils::checkConnected (token, uid, self._config) {
                if !db:.findSub (uid, toWhom) {
                    db:.insertSub (uid, toWhom);
                }

                return json#{"code" : ResponseCode::OK};
            }

        }?; // catch

        return json#{"code" : ResponseCode::ERROR};
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          REMOVING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn remove (mut self, rqt : &Config)-> &Config {
        let dmut db = if let Ok (dmut db) = alias self._db { alias db }
        else {
            return json#{"code" : ResponseCode::ERROR};
        }

        {
            let uid = rqt ["userId"].to!{u32} ();
            let toWhom = rqt ["toWhom"].to!{u32} ();
            let token = rqt ["token"].to!{[c8]} ();

            if user::utils::checkConnected (token, uid, self._config) {
                db:.removeSub (uid, toWhom);
                return json#{"code" : ResponseCode::OK};
            }
        }?; // catch

        return json#{"code" : ResponseCode::ERROR};
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          FINDING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn isSub (mut self, rqt : &Config)-> &Config {
        let dmut db = if let Ok (dmut db) = alias self._db { alias db }
        else {
            return json#{"code" : ResponseCode::ERROR};
        }

        {
            let uid = rqt ["userId"].to!{u32} ();
            let toWhom = rqt ["toWhom"].to!{u32} ();
            let isSub = db:.findSub (uid, toWhom);

            return json#{"code" : ResponseCode::OK, "result" : if (isSub) { 1 } else { 0 }};
        }?; // catch

        return json#{"code" : ResponseCode::ERROR};
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          COUNTING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn count (mut self, rqt : &Config, subs : bool)-> &Config {
        let dmut db = if let Ok (dmut db) = alias self._db { alias db }
        else {
            return json#{"code" : ResponseCode::ERROR};
        }

        {
            let uid = rqt ["userId"].to!{u32} ();
            let nb = if subs {
                db:.countSubs (uid)
            } else {
                db:.countFollowers (uid)
            };

            return json#{"code" : ResponseCode::OK, "nb" : nb};
        }?; // catch

        return json#{"code" : ResponseCode::ERROR};
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          FINDING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn find (mut self, rqt : &Config, subs : bool)-> &Config {
        let dmut db = if let Ok (dmut db) = alias self._db { alias db }
        else {
            return json#{"code" : ResponseCode::ERROR};
        }

        {
            let uid = rqt ["userId"].to!{u32} ();
            let page = rqt ["page"].to!{u32} ();
            let nb = rqt ["nb"].to!{u32} ();

            let lst = if subs {
                db:.findSubs (uid, page, nb)
            } else {
                db:.findFollowers (uid, page, nb)
            };

            return json#{"code" : ResponseCode::OK, "list" : lst};
        }?; // catch

        return json#{"code" : ResponseCode::ERROR};
    }


}
