in log;

use std::{io, conv, traits, stream, format};

pub enum
| PURPLE = "\u{0x001B}[1;35m"s8
| BLUE = "\u{0x001B}[1;36m"s8
| YELLOW = "\u{0x001B}[1;33m"s8
| RED = "\u{0x001B}[1;31m"s8
| GREEN = "\u{0x001B}[1;32m"s8
| BOLD = "\u{0x001B}[1;50m"s8
| UNDERLINE = "\u{0x001B}[4m"s8
| RESET = "\u{0x001B}[0m"s8
 -> Colors;

pub fn info {T...} (padd : [c8] = "\t", what : [c8], who : [c8], params : T) {
    let dmut stream = copy StringStream ();
    cte if isTuple!{typeof (params)} {
        for i in params {
            stream:.write (i);
        }
    } else stream:.write (params);

    let msg = align (Colors::GREEN, what, who, stream[]);
    atomic {
        println (padd, msg);
    }
}

pub fn debug {T...} (padd : [c8] = "\t", what : [c8], who : [c8], params : T) {
    let dmut stream = copy StringStream ();
    cte if isTuple!{typeof (params)} {
        for i in params {
            stream:.write (i);
        }
    } else stream:.write (params);

    let msg = align (Colors::PURPLE, what, who, stream[]);
    atomic {
        println (padd, msg);
    }
}

pub fn warn {T...} (padd : [c8] = "\t", what : [c8], who : [c8], params : T) {
    let dmut stream = copy StringStream ();
    cte if isTuple!{typeof (params)} {
        for i in params {
            stream:.write (i);
        }
    } else stream:.write (params);

    let msg = align (Colors::YELLOW, what, who, stream[]);
    atomic {
        println (padd, msg);
    }
}

pub fn error {T...} (padd : [c8] = "\t", what : [c8], who : [c8], params : T) {
    let dmut stream = copy StringStream ();
    cte if isTuple!{typeof (params)} {
        for i in params {
            stream:.write (i);
        }
    } else stream:.write (params);

    let msg = align (Colors::RED, what, who, stream[]);
    atomic {
        eprintln (padd, msg);
    }
}


fn align (color : Colors, what : [c8], who : [c8], txt : [c8])-> [c8] {
    format ("{1: <*} {3: <*} {4}",
            20, format ("{}{}{}", color, what, Colors::RESET),
            25, format ("[{}{}{}]", Colors::BLUE, who, Colors::RESET),
            txt)
} catch {
    _ => { what ~ " " ~ who ~ " " ~ txt }
}
