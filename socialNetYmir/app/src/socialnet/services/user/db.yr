in db;

use socialnet::utils::mysql;
use std::conv;

def LOGIN_LEN = 16u32;
def PASSWORD_LEN = 64u32;

pub class UserDatabase {

    let dmut _client : &MysqlClient;

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self (server : [c8], user : [c8], password : [c8], db : [c8], port : u16)
        with _client = copy MysqlClient (server-> server,
                                         user-> user,
                                         password-> password,
                                         db-> db,
                                         port-> port)
        throws AssertError
    {
        self:.createTables ();
        log::info ("Database", "user", "database configured");
    }


    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Create the table containing user information
     * */
    fn createTables (mut self)
        throws AssertError
    {
        let dmut rqt = self._client:.prepare ("CREATE TABLE IF NOT EXISTS users (\n"
                                              ~ "id INT PRIMARY KEY NOT NULL AUTO_INCREMENT,\n"
                                              ~ "login VARCHAR(" ~ to!{[c8]} (LOGIN_LEN) ~ ") NOT NULL,\n"
                                              ~ "password VARCHAR(" ~ to!{[c8]} (PASSWORD_LEN) ~ ") NOT NULL\n)");
        rqt:.finalize ();
        rqt:.execute ();
        rqt:.dispose ();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          INSERTION          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Insert a new user in the database
     * @params:
     *    - login: the login of the user
     *    - password: the password of the user
     * @returns: the id of the inserted user
     * */
    pub fn insertUser (mut self, login : [c8], password : [c8])-> u32
        throws AssertError
    {
        let dmut rqt = self._client:.prepare ("INSERT INTO users (login, password) values (?, ?)");
        rqt:.setParam (0, login);
        rqt:.setParam (1, password);

        rqt:.finalize ();
        rqt:.execute ();

        let ret = rqt.getGeneratedId ();
        rqt:.dispose ();

        ret
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          FINDING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Find a user in the database based on its login
     * @params:
     *   - login: the login of the user
     * @returns: a user info if found
     *    - .0: the id
     *    - .1: the password
     * */
    pub fn findByLogin (mut self, login : [c8])-> ((u32, [c8]))?
        throws AssertError
    {
        let dmut rqt = self._client:.prepare ("SELECT id, password from users where login=?");
        rqt:.setParam (0, login);
        rqt:.setResult!{i32} (0);
        rqt:.setResult!{[c8]} (1, PASSWORD_LEN);

        rqt:.finalize ();
        rqt:.execute ();
        if rqt:.next () {
            let res = {
                let id = rqt.getResult!{u32} (0);
                let pass = rqt.getResult!{[c8]} (1);
                (id, pass)
            }?;

            rqt:.dispose ();
            return res;
        }

        rqt:.dispose ();
        none
    }

    /**
     * Find a user in the database based on its id
     * @params:
     *   - id: the id of the user
     * @returns: a user info if found
     *    - .0: the login
     *    - .1: the password
     * */
    pub fn findById (mut self, id : u32)-> (([c8], [c8]))?
        throws AssertError
    {
        let dmut rqt = self._client:.prepare ("SELECT login, password from users where id=?");
        rqt:.setParam (0, id);
        rqt:.setResult!{[c8]} (0, LOGIN_LEN);
        rqt:.setResult!{[c8]} (1, PASSWORD_LEN);

        rqt:.finalize ();
        rqt:.execute ();
        if rqt:.next () {
            let res = {
                let login = rqt.getResult!{[c8]} (0);
                let pass = rqt.getResult!{[c8]} (1);
                (login, pass)
            }?;

            rqt:.dispose ();
            return res;
        }

        rqt:.dispose ();
        none
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          DISPOSING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub fn dispose (mut self) {
        self._client:.dispose ();
    }

    __dtor (mut self) {
        self:.dispose ();
    }

}
