in cache;

use std::net::{_, addr::_};
use std::{conv::_, config::_};

pub record CacheConfig {

    pub let mut name = "";
    pub let mut addr : &IpAddr = Ipv4::LOCALHOST;
    pub let mut port : u16 = 0;

    pub self empty () {}

    pub self (name : [c8], cfg : &Config)
        with name = name
        throws CastFailure
    {
        if let Ok (i) = cfg ["port"]? {
            self.port = cast!u16 (i.to!{i64} ());
        }

        if let Ok (s) = cfg ["addr"]? {
            self.addr = s.to!{[c8]} ().to!{&IpAddr} ();
        }
    } catch {
        inE => {
            throw copy CastFailure ((&Config)::__typeinfo__, CacheConfig::typeinfo, subError-> (inE)?);
        }
    }

}
