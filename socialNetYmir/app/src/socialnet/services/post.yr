in post;

mod ::db;

use std::io;
use std::concurrency::actor;
use std::config::_;
use std::syntax::_;
use std::net::addr;

use std::{stream, format, conv};

use socialnet::registry::_;
use socialnet::utils::_;
use socialnet::config::_;

pub class PostService over ActorBase {

    let _config : SocialNetConfiguration;
    let _serviceConfig : ServiceConfig;

    // The registry of the service
    let dmut _registry : (&ActorRef)? = none;
    let mut _uid = 0us;
    let mut _needClose = false;

    let dmut _db : (&db::PostDatabase)? = none;

    pub self (serviceConfig : ServiceConfig, systemConfig : SocialNetConfiguration)
        with _config = systemConfig
        , _serviceConfig = serviceConfig
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =================================          CONFIGURATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onStart (mut self) {
        if self:.connectDatabase () {
            self:.connectRegistry ();
        }
    }

    fn connectDatabase (mut self)-> bool {
        log::info ("Starting", ServiceKind::POST, "service connect database ", self._serviceConfig.db);
        for d in self._config.databases {
            if d.name == self._serviceConfig.db {
                self._db = (copy db::PostDatabase (server-> d.addr.to!{[c8]} (),
                                                   user-> d.user,
                                                   password-> d.password,
                                                   db-> d.dbName,
                                                   port-> d.port))?;
            }
        }

        if let Err (msg) = self._db {
            log::error ("Failed", ServiceKind::POST, "failed to configure post database => ", msg);
            self:.kill ();
            return false;
        }
        else if let Err () = self._db {
            log::error ("Failed", ServiceKind::POST, "failed to configure post database");
            self:.kill ();
            return false;
        }

        true
    }

    fn connectRegistry (mut self) {
        let regAddr = SockAddr (self._config.registry.addr, self._config.registry.port);
        log::info ("Starting", ServiceKind::POST, "service connect registry ", regAddr);
        let dmut actor = self:.system:.remote (self._config.registry.name, regAddr);

        if let Ok (uid) = registry::utils::connect (alias actor, ServiceKind::POST, self._name, SockAddr (self._config.system.loopback, self:.system.port)) {
            log::info ("Connected", ServiceKind::POST, "service");
            self._needClose = true;
            self._uid = uid;
            self._registry = (alias actor)?;
        } else {
            log::error ("Failed", ServiceKind::POST, "registry connection. Aborting ", self._name);
            self:.kill ();
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          EXIT          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onQuit (mut self) {
        log::warn ("Killing", ServiceKind::POST, "service ", self._name);
        if let Ok (dmut reg) = alias self._registry && self._needClose {
            registry::utils::close (alias reg, ServiceKind::POST, self._name, SockAddr (self._config.system.loopback, self:.system.port));
        }

        if let Ok (dmut db) = alias self._db {
            db:.dispose ();
            self._db = none;
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          MESSAGING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub over onMessage (mut self, rqt : &Config) {
        if let Ok (Int (value-> RequestCode::POISON_PILL)) = rqt ["code"]? {
            log::info ("Received", ServiceKind::POST, "poison pill in ", self._name);
            self._needClose = false; // message comes from registry, no need to inform it from service exit
            self:.kill ();
        }
    }

    pub over onRequest (mut self, rqt : &Config)-> &Config {
        match rqt ["code"]? {
            Ok (Int (value-> RequestCode::INSERT_POST)) => {
                self:.insert (rqt)
            }
            Ok (Int (value-> RequestCode::FIND_POST)) => {
                self:.find (rqt)
            }
            _ => {
                json#{"code" : ResponseCode::MALFORMED}
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          NEW POST          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn insert (mut self, rqt : &Config)-> &Config {
        let dmut reg = if let Ok (dmut reg) = alias self._registry { alias reg }
        else {
            return json#{"code" : ResponseCode::ERROR};
        };

        let dmut db = if let Ok (dmut db) = alias self._db { alias db }
        else {
            return json#{"code" : ResponseCode::ERROR};
        };

        {
            let userId = rqt ["userId"].to!{u32} ();
            let userLogin = rqt ["userLogin"].to!{[c8]} ();
            let jwt = rqt ["jwt"].to!{[c8]} ();
            let text = rqt ["text"].to!{[c8]} ();
            let tags = rqt ["tags"].to!{[u32]} ();

            let id = db:.insert (userId, userLogin, text, tags);
            let msg = json#{"code" : RequestCode::UPDATE_TIMELINE,
                            "jwt_token" : jwt,
                            "tags" : tags,
                            "postId" : id,
                            "userId" : userId};

            if let Ok (dmut timeline) = alias registry::utils::find (alias reg, "timeline") {
                timeline:.send (msg);
                return json#{"code" : ResponseCode::OK};
            }
        } catch {
            _ => {}
        }

        return json#{"code" : ResponseCode::ERROR};
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          FIND          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    fn find (mut self, rqt : &Config)-> &Config {
        let dmut db = if let Ok (dmut db) = alias self._db { alias db }
        else {
            return json#{"code" : ResponseCode::ERROR};
        };

        {
            let post = rqt ["postId"].to!{u32} ();
            if let Ok ((userId, userLogin, text, tags)) = db:.find (post) {
                return json#{"code" : ResponseCode::OK,
                             "userId" : userId,
                             "userLogin" : userLogin,
                             "text" : text,
                             "tags" : tags};
            } else {
                return json#{"code" : ResponseCode::NOT_FOUND};
            }
        } catch {
            _ => {}
        }

        return json#{"code" : ResponseCode::ERROR};
    }

}
