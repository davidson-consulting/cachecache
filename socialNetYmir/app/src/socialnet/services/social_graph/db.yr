in db;

use std::{fs::_, conv, io};
use socialnet::utils::log;

pub class SocialGraphDatabase {

    let _subs : Path;
    let _folls : Path;

    pub self ()
        with _subs = Path (".subs")
        , _folls = Path (".folls")
        throws AssertError
    {
        sys::createDir (self._subs, recursive-> true);
        sys::createDir (self._folls, recursive-> true);
    } catch {
        _ => throw copy AssertError ("Failed to configure db");
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          WRITING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub fn insertSub (mut self, uid : u32, toWhom : u32) {
        self:.writeFile (uid, toWhom, self._subs);
        self:.writeFile (toWhom, uid, self._folls);
    }

    fn writeFile (mut self, uid : u32, what : u32, base : Path) {
        {
            let filename = base.push (to!{[c8]} (uid));
            let dmut f = if fs::sys::isFile (filename) {
                File::open (filename, write-> true)
            } else {
                File::create (filename, write-> true)
            };


            {
                f:.lock ();
                f:.seek (f.len ());
                f:.writeRaw (copy [what]);
            } exit {
                f:.unlock ()?;
                f:.close ();
            }
        } catch {
            err => { log::error ("Failed", "social", "write ", err); }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          FINDING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub fn findSub (mut self, uid : u32, toWhom : u32)-> bool {
        self:.readInFile (uid, toWhom, self._subs)
    }

    pub fn findFollower (mut self, uid : u32, sub : u32)-> bool {
        self:.readInFile (uid, sub, self._folls)
    }

    fn readInFile (mut self, uid : u32, sub : u32, base : Path)-> bool {
        {
            let filename = base.push (to!{[c8]} (uid));
            let dmut f = File::open (filename, read-> true);

            {
                f:.lock ();
                let dmut buffer = copy [0u32 ; 255];
                loop {
                    let read = f:.readRaw (alias buffer);
                    for z in read if z == sub {
                        return true;
                    }

                    if read.len != 255 { break; }
                }
            } exit {
                f:.unlock ()?;
                f:.close ();
            }

        } catch {
            _ => {}
        }

        false
    } 

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          REMOVING          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub fn removeSub (mut self, uid : u32, toWhom : u32) {
        if self:.removeInFile (uid, toWhom, self._subs) {
            self:.removeInFile (toWhom, uid, self._folls);
        }
    }

    fn removeInFile (mut self, uid : u32, what : u32, base : Path)-> bool {
        {
            let filename = base.push (to!{[c8]} (uid));
            if !fs::sys::isFile (filename) return false; // no need to make a copy, no subscription or no followers

            let filename_cp = base.push (to!{[c8]} (uid) ~ "_copy");
            let dmut f = File::open (filename, read-> true);
            let dmut cp = File::create (filename_cp, write-> true);
            let mut found = false;

            {
                f:.lock ();
                cp:.lock ();
                let dmut buffer = copy [0u32 ; 255];
                let dmut rdBuffer = copy [0u32 ; 255];
                let mut nb = 0us;
                loop {
                    let read = f:.readRaw (alias rdBuffer);

                    nb = 0;
                    for z in read {
                        if z == what {
                            found = true;
                        } else {
                            buffer [nb] = z;
                            nb += 1;
                        }
                    }

                    if nb != 0 {
                        cp:.writeRaw (buffer [0 .. nb]);
                    }
                    if read.len != 255 { break; }
                }
            } exit {
                f:.unlock ()?;
                cp:.unlock ()?;
                cp:.close ();
                f:.close ();
            }

            // replace the files
            fs::sys::copyFile (filename_cp, filename);
            return found;
        } catch {
            _ => {}
        }

        false
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          READING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub fn findSubs (mut self, uid : u32, page : u32, nb : u32)-> [u32] {
        self:.readFile (uid, page, nb, self._subs)
    }

    pub fn findFollowers (mut self, uid : u32, page : u32, nb : u32)-> [u32] {
        self:.readFile (uid, page, nb, self._folls)
    }

    fn readFile (mut self, uid : u32, page : u32, nb : u32, base : Path)-> [u32] {
        let dmut result : [u32] = [];
        {
            let filename = base.push (to!{[c8]} (uid));
            let dmut f = File::open (filename, read-> true);

            {
                f:.lock ();
                let offset = page * nb;
                let nbAll = f.len () / u32::size;
                if offset > nbAll return [];

                f:.seek (offset * u32::size);
                let toRead = std::algorithm::comparison::min (nbAll - offset, nb);

                let dmut buffer = copy [0u32 ; toRead];
                result = f:.readRaw (alias buffer);
            } exit {
                f:.unlock ()?;
                f:.close ();
            }
        } catch {
            _ => {}
        }

        result
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          LENGTHS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub fn countSubs (mut self, uid : u32)-> u32 {
        self:.countFile (uid, self._subs)
    }

    pub fn countFollowers (mut self, uid : u32)-> u32 {
        self:.countFile (uid, self._folls)
    }

    fn countFile (mut self, uid : u32, base : Path)-> u32 {
        {
            let filename = base.push (to!{[c8]} (uid));
            let dmut f = File::open (filename, read-> true);

            {
                return f.len () / u32::size;
            } exit {
                f:.close ();
            }

        } catch {
            _ => {}
        }

        0us
    }


}
